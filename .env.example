# ─── Port ─────────────────────────────────────────────────────────────────────
PORT=8080

# ─── Live Trading ─────────────────────────────────────────────────────────────
# Cukup set PRIVATE_KEY untuk mengaktifkan live trading (LIVE_TRADING tidak diperlukan)
# PRIVATE_KEY=hex_private_key_tanpa_prefix_0x
# BASE_RPC_URL=https://mainnet.base.org
# BASE_RPC_URL_BACKUP=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# TRADE_SIZE_ETH=0.001

# ─── Risk Level ───────────────────────────────────────────────────────────────
# RISK_LEVEL=normal   ← conservative | normal (default) | aggressive

# ─── Telegram Notifikasi ──────────────────────────────────────────────────────
# Aktifkan untuk menerima alert di HP/PC setiap ada entry, exit, atau sinyal penting
#
# Cara setup:
#   1. Buka Telegram, cari @BotFather → /newbot → salin token
#   2. Kirim pesan apapun ke bot kamu
#   3. Buka: https://api.telegram.org/bot<TOKEN>/getUpdates
#      Salin "id" dari "from" (chat_id kamu)
#   4. Untuk grup: tambahkan bot ke grup, kirim pesan, ambil chat_id (negatif, misal -1001234...)
#
# TG_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TG_CHAT_ID=987654321
#
# Atur sinyal apa yang dikirim (default: EARLY_GEM,BREAKOUT,MOMENTUM):
# TG_SIGNALS=EARLY_GEM,BREAKOUT,MOMENTUM
# TG_SIGNALS=none   ← nonaktifkan notifikasi sinyal (hanya entry/exit yang dikirim)
#
# Test setelah setting: curl http://localhost:PORT/api/telegram-test

# ─── Slippage Protection ──────────────────────────────────────────────────────
# SLIPPAGE_PCT=5.0   ← persentase slippage maksimum (default: 5%)
#                      Lebih kecil = proteksi lebih ketat, tapi lebih sering gagal
#                      Lebih besar = lebih sering berhasil, tapi harga bisa jelek
#                      Rekomendasi: 3-5% untuk meme coin (likuiditas rendah)
